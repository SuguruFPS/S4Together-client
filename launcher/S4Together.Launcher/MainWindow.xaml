<Window x:Class="S4Together.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:S4Together.Launcher"
        Title="S4Together" Width="1160" Height="780" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" FontFamily="Segoe UI" FontSize="13">
  <!-- Disposition façon EA app : menu | contenu | profil et amis (maquette launcher-ea.html). -->
  <Grid Background="{StaticResource Bg}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="216"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="224"/>
    </Grid.ColumnDefinitions>

    <!-- Menu de gauche -->
    <Border Background="{StaticResource Panel}" Padding="14,22,14,14">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="8,0,0,30">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <!-- Logo : losange vert façon plumbob. -->
          <Path Width="16" Height="26" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"
                Data="M 11,0 L 22,17 L 11,34 L 0,17 Z M 11,0 L 11,34 M 0,17 L 22,17" Fill="{StaticResource Online}" Stroke="#2E8A62" StrokeThickness="0.8"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="S4Together" FontSize="19" FontWeight="Bold"/>
            <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" FontSize="10"/>
          </StackPanel>
        </Grid>
        <!-- État de connexion et ping mesuré par le heartbeat. -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Pill}" HorizontalAlignment="Stretch" Padding="12,7">
          <DockPanel>
            <Ellipse x:Name="NavStatusDot" Width="8" Height="8" Fill="{StaticResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="PingText" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextWrapping="NoWrap"
                       AutomationProperties.Name="Latence avec le serveur"/>
            <TextBlock x:Name="NavStatus" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap"/>
          </DockPanel>
        </Border>
        <!-- Tous les éléments du menu restent dans ce panneau : NavTo les parcourt. -->
        <StackPanel x:Name="NavMenu" DockPanel.Dock="Top">
          <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" local:NavIcon.Glyph="&#xE80F;" Content="Accueil" IsChecked="True" Checked="Nav_Checked" Tag="PageHome"/>
          <RadioButton x:Name="NavServers" Style="{StaticResource Nav}" local:NavIcon.Glyph="&#xE774;" Content="Parcourir les serveurs" Checked="Nav_Checked" Tag="PageServer"/>
          <RadioButton x:Name="NavCharacters" Style="{StaticResource Nav}" local:NavIcon.Glyph="&#xE77B;" Content="Mon personnage" Checked="Nav_Checked" Tag="PageSim" Visibility="Collapsed"/>
          <RadioButton x:Name="NavCommunity" Style="{StaticResource Nav}" local:NavIcon.Glyph="&#xE8BD;" Content="Tchat et joueurs" Checked="Nav_Checked" Tag="PageCommunity" IsEnabled="False" Visibility="Collapsed"/>
          <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" local:NavIcon.Glyph="&#xE713;" Content="Paramètres" Checked="Nav_Checked" Tag="PageSettings"/>
          <RadioButton x:Name="NavHost" Style="{StaticResource Nav}" local:NavIcon.Glyph="&#xE968;" Content="Héberger" Checked="Nav_Checked" Tag="PageHost"/>
          <RadioButton x:Name="NavGame" Style="{StaticResource Nav}" local:NavIcon.Glyph="&#xE7FC;" Content="Jeu et mod" Checked="Nav_Checked" Tag="PageGame" Visibility="Collapsed"/>
          <RadioButton x:Name="NavDiagnostic" Style="{StaticResource Nav}" local:NavIcon.Glyph="&#xE9D9;" Content="Diagnostic" Checked="Nav_Checked" Tag="PageDiag" Visibility="Collapsed"/>
          <RadioButton x:Name="NavAdmin" Style="{StaticResource Nav}" local:NavIcon.Glyph="&#xE83D;" Content="Admin" Checked="Nav_Checked" Tag="PageAdmin" Visibility="Collapsed"/>
        </StackPanel>
        <!-- Mon jeu : état réel de l'installation et du mod. -->
        <StackPanel Margin="0,14,0,0" VerticalAlignment="Top">
          <Border Height="1" Background="{StaticResource Line}" Margin="4,0,4,16"/>
          <TextBlock Text="MON JEU" Style="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,10"/>
          <Button x:Name="MyGameTile" Tag="PageGame" Click="OpenPage_Click" Padding="8" Margin="0" Background="Transparent" BorderBrush="Transparent"
                  HorizontalContentAlignment="Stretch" AutomationProperties.Name="Les Sims 4 : jeu et mod">
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="4" Margin="0,0,10,0" Background="#2E6B55">
                <Path Width="12" Height="20" Stretch="Uniform" Data="M 11,0 L 22,17 L 11,34 L 0,17 Z" Fill="{StaticResource Online}"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Les Sims 4" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <Ellipse x:Name="MyGameDot" Width="6" Height="6" Fill="{StaticResource Online}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="MyGameState" Style="{StaticResource Muted}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                </StackPanel>
              </StackPanel>
            </DockPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Colonne centrale : barre d'outils, page, barre d'état. -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="77"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel Margin="28,0" VerticalAlignment="Center">
        <Button x:Name="BackButton" DockPanel.Dock="Left" Click="Back_Click" Content="&#xE76B;" FontFamily="{StaticResource Icons}" FontSize="12"
                Padding="10,9" Margin="0,0,12,0" Background="Transparent" BorderBrush="Transparent" ToolTip="Retour à l'accueil" AutomationProperties.Name="Retour à l'accueil"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Ellipse x:Name="ToolbarDot" Width="7" Height="7" Fill="{StaticResource Online}" Margin="0,0,7,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="ToolbarStatus" Foreground="{StaticResource ReadyText}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Background="{StaticResource SearchBg}" BorderBrush="{StaticResource SearchLine}" BorderThickness="1" CornerRadius="4" MaxWidth="460" HorizontalAlignment="Left" Width="Auto" MinWidth="240">
          <Grid>
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBlock x:Name="SearchHint" Text="Rechercher un serveur, un monde…" Style="{StaticResource Muted}" Margin="36,0,10,0" VerticalAlignment="Center" TextWrapping="NoWrap" IsHitTestVisible="False"/>
            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="32,8,10,8" MaxLength="80" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                     AutomationProperties.Name="Rechercher un serveur"/>
          </Grid>
        </Border>
      </DockPanel>

    <Grid Grid.Row="1" Margin="28,4,28,8">
      <!-- Accueil -->
      <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,0">
          <DockPanel Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Right" Text="Ton monde t'attend." Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="12,0,0,3"/>
            <TextBlock x:Name="HomeGreeting" Text="Content de te revoir." FontSize="22" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <!-- Héros : illustration originale + dégradé sombre à gauche pour le texte. -->
          <Border Height="345" CornerRadius="7" Margin="0,0,0,34">
            <Border.Background>
              <ImageBrush ImageSource="pack://application:,,,/S4Together;component/Assets/hero.png" Stretch="UniformToFill" AlignmentX="Right"/>
            </Border.Background>
            <Border CornerRadius="7">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#FA102A34" Offset="0"/>
                  <GradientStop Color="#E816313A" Offset="0.31"/>
                  <GradientStop Color="#4018383C" Offset="0.65"/>
                  <GradientStop Color="#0018383C" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Grid Margin="34,30">
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#9C17393B" CornerRadius="3" Padding="9,4">
                  <TextBlock Text="S4TOGETHER · MULTIJOUEUR" Foreground="#D0EFE0" FontSize="10" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                </Border>
                <StackPanel VerticalAlignment="Center" MaxWidth="400" HorizontalAlignment="Left">
                  <TextBlock Text="VOTRE MAISON. NOTRE MONDE." Foreground="#D0EFE0" FontSize="11" FontWeight="SemiBold"/>
                  <TextBlock Text="Une vie à toi.&#10;Un monde&#10;à partager." FontSize="37" FontWeight="Bold" LineHeight="43" Margin="0,10,0,12"/>
                  <TextBlock Text="Retrouve ton Sim, rejoins tes amis et écrivez la suite ensemble." Foreground="#D3E2E0" FontSize="14" Margin="0,0,0,22"/>
                  <Button x:Name="HomeServerButton" Style="{StaticResource Primary}" Content="Rejoindre →" Padding="26,11" FontSize="14" HorizontalAlignment="Left" Click="HomeJoin_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
                  <Border Width="18" Height="4" CornerRadius="2" Background="{StaticResource Text}" Margin="0,0,5,0"/>
                  <Border Width="6" Height="4" CornerRadius="2" Background="#80FFFFFF" Margin="0,0,5,0"/>
                  <Border Width="6" Height="4" CornerRadius="2" Background="#80FFFFFF"/>
                </StackPanel>
              </Grid>
            </Border>
          </Border>
          <TextBlock Text="LE PROJET S4TOGETHER" Foreground="{StaticResource AccentText}" FontSize="11" FontWeight="SemiBold"/>
          <Grid Margin="0,8,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ProjectIntro" Text="Les Sims 4.&#10;Ta vie, à plusieurs." FontSize="30" FontWeight="Bold" Margin="0,0,24,0"/>
            <TextBlock Grid.Column="1" Foreground="#B9C1D1" FontSize="14" LineHeight="21" VerticalAlignment="Bottom"
                       Text="S4Together est un projet multijoueur non officiel pour Les Sims 4. Notre idée : garder la liberté de raconter ta propre histoire, tout en partageant un monde avec d'autres joueurs."/>
          </Grid>
          <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,22"/>
          <UniformGrid Columns="3" Margin="0,0,0,26">
            <Border BorderBrush="{StaticResource SectionLine}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,0,14,0"><StackPanel>
              <TextBlock Text="01" Foreground="{StaticResource AccentText}" FontWeight="Bold" Margin="0,0,0,10"/>
              <TextBlock Style="{StaticResource H2}" Text="Ton Sim, ton histoire"/>
              <TextBlock Style="{StaticResource Muted}" Text="L'objectif : incarner ton propre personnage et garder le contrôle de ses choix."/>
            </StackPanel></Border>
            <Border BorderBrush="{StaticResource SectionLine}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="7,0,7,0"><StackPanel>
              <TextBlock Text="02" Foreground="{StaticResource AccentText}" FontWeight="Bold" Margin="0,0,0,10"/>
              <TextBlock Style="{StaticResource H2}" Text="Un monde à partager"/>
              <TextBlock Style="{StaticResource Muted}" Text="Retrouver ses amis, se rendre visite et faire vivre des histoires ensemble : c'est la direction du projet."/>
            </StackPanel></Border>
            <Border BorderBrush="{StaticResource SectionLine}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="14,0,0,0"><StackPanel>
              <TextBlock Text="03" Foreground="{StaticResource AccentText}" FontWeight="Bold" Margin="0,0,0,10"/>
              <TextBlock Style="{StaticResource H2}" Text="Votre façon de jouer"/>
              <TextBlock Style="{StaticResource Muted}" Text="Des serveurs entre amis ou ouverts à une communauté, avec une connexion simple depuis le launcher."/>
            </StackPanel></Border>
          </UniformGrid>
          <Border x:Name="SeasonCard" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Saison du monde"/>
              <TextBlock x:Name="SeasonText" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
              <StackPanel x:Name="SeasonChoices" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                <Button Content="Printemps" Tag="spring" Click="ChooseSeason_Click"/>
                <Button Content="Été" Tag="summer" Click="ChooseSeason_Click"/>
                <Button Content="Automne" Tag="autumn" Click="ChooseSeason_Click"/>
                <Button Content="Hiver" Tag="winter" Click="ChooseSeason_Click"/>
                <Button Content="Laisser choisir un autre joueur" Click="AbandonSeason_Click"/>
              </StackPanel>
              <TextBlock x:Name="SeasonStatus" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,8" Text="Projet en développement. Les fonctionnalités et leur compatibilité sont validées progressivement dans le jeu."/>
        </StackPanel>
      </ScrollViewer>

      <!-- Parcourir les serveurs : favoris puis catalogue public, connexion directe à part. -->
      <Grid x:Name="PageServer" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
              <TextBox x:Name="DirectoryFilter" Width="190" Margin="0,0,8,0" MaxLength="80" TextChanged="DirectoryFilter_Changed"
                       ToolTip="Filtrer par nom ou adresse" AutomationProperties.Name="Filtrer les serveurs"/>
              <ComboBox x:Name="DirectoryScope" Width="150" SelectedIndex="0" SelectionChanged="DirectoryFilter_Changed" AutomationProperties.Name="Serveurs affichés">
                <ComboBoxItem Content="Tous les serveurs"/>
                <ComboBoxItem Content="Favoris"/>
              </ComboBox>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="PARCOURIR" Foreground="{StaticResource AccentText}" FontSize="11" FontWeight="SemiBold"/>
              <TextBlock Text="Serveurs" FontSize="26" FontWeight="Bold" Margin="0,4,0,4"/>
              <TextBlock Style="{StaticResource Muted}" Text="Tes favoris en premier, puis les serveurs publiés dans le catalogue. Double-clique pour rejoindre."/>
            </StackPanel>
          </DockPanel>
          <DockPanel Margin="0,0,0,8">
            <WrapPanel DockPanel.Dock="Right">
              <Button x:Name="DirectoryRefreshButton" Content="Actualiser" Click="DirectoryRefresh_Click"/>
              <Button Content="Favori ★" Click="DirectoryFavorite_Click"/>
              <Button Content="Retirer la fiche locale" Click="DirectoryRemove_Click" Margin="0"/>
            </WrapPanel>
            <TextBlock x:Name="CatalogStatus" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
          </DockPanel>
        </StackPanel>
        <Grid Grid.Row="1">
          <ListBox x:Name="ServerDirectoryList" MinHeight="90" MouseDoubleClick="Directory_DoubleClick" SelectionChanged="Directory_SelectionChanged" KeyDown="Directory_KeyDown">
            <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource H2}" Margin="0,14,0,8"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="4,6">
                  <Border DockPanel.Dock="Left" Width="95" Height="67" CornerRadius="4" Margin="0,0,14,0">
                    <Border.Background>
                      <ImageBrush ImageSource="pack://application:,,,/S4Together;component/Assets/hero.png" Stretch="UniformToFill" AlignmentX="Right"/>
                    </Border.Background>
                  </Border>
                  <TextBlock DockPanel.Dock="Right" Text="Rejoindre →" Foreground="{StaticResource AccentText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,6,0" TextWrapping="NoWrap"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding DisplayEndpoint}" FontSize="12" Margin="0,2,0,2"/>
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock x:Name="DirectoryEmpty" Style="{StaticResource Muted}" Text="Aucun serveur public publié ni favori. Utilise « Connexion directe » pour saisir une adresse." VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"/>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource Card}" CornerRadius="4" Padding="16,12" Margin="0,14,0,0">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Connexion directe →" Click="PrivateServer_Click" Style="{StaticResource Primary}" Margin="12,0,0,0"/>
            <Button x:Name="CatalogDisconnectButton" DockPanel.Dock="Right" Content="Se déconnecter" Click="CatalogDisconnect_Click" Visibility="Collapsed" Margin="12,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Tu as déjà une adresse ?" FontWeight="SemiBold"/>
              <TextBlock x:Name="ServerStatus" Style="{StaticResource Muted}" FontSize="12" Text="Saisis l'adresse et le port donnés par l'hôte du serveur."/>
            </StackPanel>
          </DockPanel>
        </Border>
        <ContentControl x:Name="PrivateServerFormHost" Visibility="Collapsed">
          <StackPanel x:Name="PrivateServerForm">
          <TextBlock Style="{StaticResource H2}" Text="Connexion à un serveur privé"/>
          <TextBlock Text="Nom du serveur (facultatif)" Margin="0,0,0,4"/>
          <TextBox x:Name="ServerLabelBox" MaxLength="80" ToolTip="Nom de la fiche, par exemple Mon serveur" Margin="0,0,0,8"/>
          <Border Style="{StaticResource CardBorder}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Text="Adresse" VerticalAlignment="Center"/>
              <TextBox x:Name="HostBox" Grid.Column="1" Margin="0,4"/>
              <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center"/>
              <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Width="110" HorizontalAlignment="Left"/>
              <TextBlock Grid.Row="2" Text="Nom de joueur" VerticalAlignment="Center"/>
              <TextBox x:Name="NameBox" Grid.Row="2" Grid.Column="1" Margin="0,4" MaxLength="40"/>
              <TextBlock Grid.Row="3" Text="Mot de passe" VerticalAlignment="Center"/>
              <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" Margin="0,4" MaxLength="128"/>
              <CheckBox x:Name="RememberBox" Grid.Row="4" Grid.Column="1" Content="Mémoriser le mot de passe (chiffré pour ce compte Windows)"/>
            </Grid>
          </Border>
          <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"
                     Text="Saisis l'IP ou le nom du serveur et son port. La connexion Internet est chiffrée automatiquement."/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Ajouter aux favoris ★" Click="PrivateFavorite_Click"/>
            <Button Content="Tester le serveur" Click="Test_Click"/>
            <Button x:Name="ConnectButton" Style="{StaticResource Primary}" Content="Rejoindre" Click="Connect_Click"/>
          </StackPanel>

          </StackPanel>
        </ContentControl>
      </Grid>

      <!-- Le bouton reste visible : seule la collection et les détails défilent. -->
      <Grid x:Name="PageSim" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
          <DockPanel>
            <Button x:Name="CharacterServerButton" DockPanel.Dock="Right" Content="Déconnecter" Click="Connect_Click" VerticalAlignment="Top" Margin="0"/>
            <TextBlock Style="{StaticResource H1}" Text="Choisir ton personnage" Margin="0,0,0,6"/>
          </DockPanel>
          <TextBlock Style="{StaticResource Muted}" Text="Choisis ta sauvegarde ou crée un nouveau personnage."/>
        </StackPanel>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="190"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,16,0">
            <StackPanel>
              <TextBlock Text="Rechercher un personnage" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,5"/>
              <TextBox x:Name="CharacterSearch" TextChanged="CharacterSearch_Changed" MaxLength="80" Margin="0,0,12,14" AutomationProperties.Name="Rechercher un personnage"/>
              <TextBlock Text="Parties solo · importer un Sim" Style="{StaticResource H2}"/>
              <TextBlock Text="Tes sauvegardes solo restent sur ton PC." Style="{StaticResource Muted}" Margin="0,0,0,8"/>
              <ListBox x:Name="LocalSimList" Style="{StaticResource CharacterCards}" SelectionChanged="LocalSim_SelectionChanged" SelectionMode="Single" AutomationProperties.Name="Choisir ma sauvegarde">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <Border Height="124" Background="Transparent" CornerRadius="7" Margin="0,0,0,10">
                        <Grid ClipToBounds="True">
                          <StackPanel x:Name="LocalPortraitPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Image indisponible" Style="{StaticResource Muted}" FontSize="11"/>
                          </StackPanel>
                          <Image x:Name="CardPortrait" Source="{Binding Portrait}" Stretch="UniformToFill" AutomationProperties.Name="Image du foyer"/>
                          <TextBlock x:Name="NewCardPlus" Text="+" FontSize="62" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                      </Border>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                      <TextBlock Text="{Binding Household}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="36" Margin="0,3,0,8"/>
                      <TextBlock x:Name="LocalCardSource" Text="{Binding SourceLabel}" Foreground="{StaticResource Accent}" FontSize="11"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsNew}" Value="True">
                        <Setter TargetName="LocalPortraitPlaceholder" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="CardPortrait" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="NewCardPlus" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="LocalCardSource" Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="Multijoueur · personnages de ce serveur" Style="{StaticResource H2}" Margin="0,18,0,8"/>
              <Button x:Name="NewMultiplayerCharacterButton" Content="＋ Nouveau personnage multijoueur" Click="NewCharacter_Click" HorizontalAlignment="Left" Margin="0,0,0,10"/>
              <TextBlock x:Name="CharacterEmpty" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,12,10" Text="Connecte-toi au serveur pour charger tes personnages."/>
              <ListBox x:Name="CharacterList" Style="{StaticResource CharacterCards}" SelectionChanged="ServerCharacter_SelectionChanged" SelectionMode="Single" AutomationProperties.Name="Mes personnages du serveur">
                <ListBox.ItemTemplate>
                  <DataTemplate><StackPanel><Border Height="124" Background="Transparent" CornerRadius="7" Margin="0,0,0,10"><Grid><TextBlock Text="Image du personnage indisponible" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Portrait}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image Source="{Binding Portrait}" Stretch="UniformToFill"/></Grid></Border><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/></StackPanel></DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Expander Header="Actualiser ou choisir le dossier" Foreground="{StaticResource MutedBrush}" Margin="0,8,12,12">
                <StackPanel Margin="0,10,0,0">
                  <WrapPanel><Button x:Name="ScanLocalSimsButton" Content="Redétecter" Click="ScanLocalSims_Click" Margin="0,0,8,8"/><Button x:Name="RefreshCharactersButton" Content="Actualiser le serveur" Click="RefreshCharacters_Click" IsEnabled="False" Margin="0,0,8,8"/></WrapPanel>
                  <Button Content="Choisir le dossier Les Sims 4…" Click="BrowseLocalSims_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                  <TextBlock x:Name="LocalSimStatus" Style="{StaticResource Muted}" FontSize="11" Text="Recherche dans tes parties enregistrées et Ma bibliothèque."/>
                </StackPanel>
              </Expander>
              <Expander x:Name="LegacyHouseholds" Header="Foyers du serveur (avancé)" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,12">
                <StackPanel>
                  <ListBox x:Name="HouseholdList" DisplayMemberPath="Label" MinHeight="60" MaxHeight="160" Margin="0,6,0,8"/>
                  <TextBox x:Name="HouseholdName" MaxLength="40" Margin="0,0,0,8" AutomationProperties.Name="Nom du foyer"/>
                  <WrapPanel><Button Content="Créer un foyer" Click="CreateHousehold_Click" Margin="0,0,8,8"/><Button Content="Choisir ce foyer" Click="SelectHousehold_Click" Margin="0,0,8,8"/></WrapPanel>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="CreateCharacterCard" Style="{StaticResource CardBorder}" Padding="14" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Ton choix"/>
                <Border Background="#141920" CornerRadius="8" Padding="8" Margin="0,0,0,12">
                  <StackPanel>
                    <Image x:Name="LocalSimPortrait" Height="170" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="Image du foyer sélectionné"/>
                    <TextBlock x:Name="LocalSimPortraitStatus" Style="{StaticResource Muted}" FontSize="12" Text="Sélectionne une carte pour continuer."/>
                    <TextBlock x:Name="LocalSimSaveDate" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>
                <TextBlock Text="Nom du personnage" Margin="0,0,0,5"/>
                <TextBox x:Name="CharacterName" TextChanged="CharacterName_Changed" MaxLength="40" Margin="0,0,0,12" AutomationProperties.Name="Nom du personnage"/>
                <TextBlock Text="La maison et le terrain se choisissent dans Les Sims 4." Style="{StaticResource Muted}" FontSize="12"/>
                <Border x:Name="GameStartGuide" Background="#141920" CornerRadius="8" Padding="12" Margin="0,14,0,0" Visibility="Collapsed">
                  <StackPanel>
                    <TextBlock Text="Dans le menu du jeu" FontWeight="SemiBold"/>
                    <TextBlock x:Name="GameStartAction" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,6"/>
                    <TextBlock x:Name="GameStartDetails" Style="{StaticResource Muted}" FontSize="12"/>
                  </StackPanel>
                </Border>
                <CheckBox x:Name="KeepMoney" Visibility="Collapsed" Margin="0,14,0,0" Checked="ImportOptions_Changed" Unchecked="ImportOptions_Changed"><TextBlock Text="Garder l'argent de mon foyer solo" TextWrapping="Wrap"/></CheckBox>
                <TextBlock x:Name="ImportMoneyHint" Visibility="Collapsed" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
                <Button x:Name="DeleteCharacterButton" Content="Supprimer ce personnage du serveur…" Click="DeleteCharacter_Click" Visibility="Collapsed" ToolTip="Ferme le jeu avant de supprimer un personnage." Margin="0,16,0,0"/>
                <Expander x:Name="CreationOptions" Header="Options avancées" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}">
                  <StackPanel Margin="0,10,0,0">
                    <RadioButton x:Name="OriginCas" GroupName="Origin" IsChecked="True" Visibility="Collapsed" Checked="Origin_Changed"/>
                    <RadioButton x:Name="OriginImport" GroupName="Origin" Visibility="Collapsed" Checked="Origin_Changed"/>
                    <CheckBox x:Name="KeepHouse" IsEnabled="False" IsChecked="False" Margin="0,0,0,10"><TextBlock Text="Garder la maison (import)"/></CheckBox>
                    <TextBlock Text="Terrain du serveur (facultatif)" FontSize="12" Margin="0,0,0,5"/>
                    <ComboBox x:Name="LotChoice" DisplayMemberPath="Label" AutomationProperties.Name="Terrain"/>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,6" Margin="0,14,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock x:Name="CharacterHint" Style="{StaticResource Muted}" FontSize="12"/>
              <TextBlock x:Name="SimStatus" TextWrapping="Wrap" Margin="0,5,0,0"/>
              <TextBlock x:Name="PlayHint" Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" ToolTip="« Lancer le jeu » vérifie le mod, prépare la liaison locale avec le jeu puis lance Les Sims 4 depuis EA app ou Steam."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
              <Button x:Name="PlayButton" Content="Lancer le jeu" Click="Play_Click" Padding="18,12" Margin="0,0,10,0" VerticalAlignment="Bottom"/>
              <Button x:Name="JoinButton" Style="{StaticResource Primary}" Content="Rejoindre" Click="SelectCharacter_Click" IsEnabled="False" MinWidth="150" Padding="24,12" FontSize="16" Margin="0" VerticalAlignment="Bottom"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- Communauté -->
      <Grid x:Name="PageCommunity" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="2">
          <TextBlock Style="{StaticResource H1}" Text="Tchat et joueurs"/>
          <TextBlock x:Name="ChatStatus" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        </StackPanel>
        <ListBox x:Name="ChatList" Grid.Row="1" Margin="0,0,12,8"/>
        <DockPanel x:Name="ChatComposer" Grid.Row="2" Margin="0,0,12,0" IsEnabled="False">
          <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Envoyer" Click="SendChat_Click" Margin="8,0,0,0"/>
          <TextBox x:Name="ChatBox" MaxLength="1000" KeyDown="ChatBox_KeyDown"/>
        </DockPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Grid.RowSpan="2">
          <TextBlock Style="{StaticResource H2}" Text="En ligne"/>
          <ListBox x:Name="PlayerList" Height="170" DisplayMemberPath="Label"/>
          <Button Content="Ajouter aux amis" Click="AddFriend_Click" Margin="0,6,0,14" HorizontalAlignment="Left"/>
          <TextBlock Style="{StaticResource H2}" Text="Amis"/>
          <ListBox x:Name="FriendList" Height="120"/>
          <Button Content="Retirer" Click="RemoveFriend_Click" Margin="0,6,0,10" HorizontalAlignment="Left"/>
          <TextBlock Style="{StaticResource Muted}" FontSize="11"
                     Text="Les invitations et la liste d'amis partagée arrivent avec le serveur (cartes en cours) ; la liste d'amis est locale pour l'instant."/>
        </StackPanel>
      </Grid>

      <!-- Mod et jeu -->
      <ScrollViewer x:Name="PageGame" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock Style="{StaticResource H1}" Text="Jeu et mod S4Together"/>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Les Sims 4"/>
              <ComboBox x:Name="GameCombo" DisplayMemberPath="Label" SelectionChanged="GameCombo_SelectionChanged" Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="Choisir le dossier du jeu…" Click="BrowseGame_Click"/>
                <Button Content="Redétecter" Click="Redetect_Click"/>
              </StackPanel>
              <TextBlock x:Name="PacksText" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Dossier Mods du profil"/>
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Parcourir…" Click="BrowseMods_Click" Margin="8,0,0,0"/>
                <ComboBox x:Name="ModsCombo" IsEditable="True" LostFocus="ModsCombo_Changed" SelectionChanged="ModsCombo_Changed"/>
              </DockPanel>
              <TextBlock x:Name="ModState" Margin="0,0,0,4"/>
              <TextBlock x:Name="ModOptions" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
              <WrapPanel>
                <Button x:Name="InstallButton" Style="{StaticResource Primary}" Content="Installer" Click="Install_Click" Margin="0,0,8,6"/>
                <Button x:Name="EnableScriptsButton" Content="Activer les mods de script" Click="EnableScripts_Click" Margin="0,0,8,6"/>
                <Button x:Name="UninstallButton" Content="Désinstaller" Click="Uninstall_Click" Margin="0,0,8,6"/>
                <Button Content="Gérer les mods du serveur…" Click="ManageServerMods_Click" Margin="0,0,8,6"/>
              </WrapPanel>
              <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"
                         Text="Chaque action demande ton accord. Les anciennes copies et Options.ini sont sauvegardés dans %LOCALAPPDATA%\S4Together\launcher\backups. Aucun autre mod ni sauvegarde de partie n'est touché. Jeu fermé obligatoire."/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Copies de sécurité multijoueur"/>
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                Text="Le launcher conserve jusqu'à 10 copies des parties enregistrées correspondant à ton personnage multijoueur. L'original reste intact. Ces copies ne récupèrent pas les actions que Les Sims 4 n'a pas encore enregistrées."/>
              <Button Content="Ouvrir mes copies de sécurité" HorizontalAlignment="Left" Click="OpenSaveBackups_Click"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Paramètres : profil, jeu et mod, diagnostic. -->
      <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,6,0">
          <TextBlock Text="RÉGLAGES" Foreground="{StaticResource AccentText}" FontSize="11" FontWeight="SemiBold"/>
          <TextBlock Text="Paramètres" FontSize="26" FontWeight="Bold" Margin="0,4,0,18"/>
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Profil du joueur"/>
              <TextBlock Style="{StaticResource Muted}" Text="Ce pseudo est montré aux autres joueurs sur le serveur (2 à 40 caractères)." Margin="0,0,0,10"/>
              <TextBlock Text="Pseudo" Margin="0,0,0,4"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Appliquer" Click="ApplyName_Click" Margin="10,0,0,0"/>
                <TextBox x:Name="SettingsNameBox" MaxLength="40" AutomationProperties.Name="Pseudo"/>
              </DockPanel>
              <TextBlock x:Name="SettingsNameStatus" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="Gérer →" Tag="PageGame" Click="OpenPage_Click" Style="{StaticResource Link}" VerticalAlignment="Top"/>
                <StackPanel><TextBlock Style="{StaticResource H2}" Text="Jeu et mod"/><TextBlock Style="{StaticResource Muted}" Text="Dossier du jeu, installation du mod, copies de sécurité."/></StackPanel>
              </DockPanel>
              <UniformGrid Columns="2">
                <StackPanel Margin="0,0,10,10"><TextBlock Text="Jeu" FontWeight="SemiBold"/><TextBlock x:Name="HomeGame" Style="{StaticResource Muted}"/></StackPanel>
                <StackPanel Margin="10,0,0,10"><TextBlock Text="Mod S4Together" FontWeight="SemiBold"/><TextBlock x:Name="HomeMod" Style="{StaticResource Muted}"/></StackPanel>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="Serveur" FontWeight="SemiBold"/><TextBlock x:Name="HomeServer" Style="{StaticResource Muted}"/></StackPanel>
                <StackPanel Margin="10,0,0,0"><TextBlock Text="Liaison avec le jeu" FontWeight="SemiBold"/><TextBlock x:Name="HomeBridge" Style="{StaticResource Muted}"/></StackPanel>
              </UniformGrid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Fermeture du launcher"/>
              <CheckBox x:Name="TrayBox" Content="Réduire dans la zone de notification pendant le jeu" Click="TrayBox_Click"/>
              <CheckBox x:Name="CloseWarnBox" Content="Prévenir avant de fermer quand je suis connecté" Click="CloseWarnBox_Click" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Lancer le diagnostic →" Tag="PageDiag" Click="OpenPage_Click" Style="{StaticResource Outline}" VerticalAlignment="Center"/>
              <StackPanel><TextBlock Style="{StaticResource H2}" Text="Diagnostic et assistance"/><TextBlock Style="{StaticResource Muted}" Text="Journal du launcher et informations à envoyer en cas de problème."/></StackPanel>
            </DockPanel>
          </Border>
          <Border BorderBrush="{StaticResource AccentText}" BorderThickness="3,0,0,0" Background="{StaticResource Card}" CornerRadius="0,4,4,0" Padding="16,12" Margin="0,0,0,14">
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Le mot de passe d'un serveur privé reste chiffré pour ton compte Windows. Le launcher ne modifie jamais tes sauvegardes : il en fait seulement des copies."/>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Héberger : formulaire de préparation ; l'hébergement depuis le launcher n'existe pas encore. -->
      <ScrollViewer x:Name="PageHost" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,6,0">
          <TextBlock Text="HÉBERGER" Foreground="{StaticResource AccentText}" FontSize="11" FontWeight="SemiBold"/>
          <TextBlock Text="Crée ton monde" FontSize="26" FontWeight="Bold" Margin="0,4,0,4"/>
          <TextBlock Style="{StaticResource Muted}" Text="Prépare un serveur pour jouer avec tes amis ou ouvrir ton monde à d'autres joueurs." Margin="0,0,0,18"/>
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Nom du serveur" Margin="0,0,0,4"/>
              <TextBox x:Name="HostNameBox" MaxLength="60" Margin="0,0,0,14" AutomationProperties.Name="Nom du serveur à héberger"/>
              <TextBlock Text="Qui peut rejoindre ?" Margin="0,0,0,6"/>
              <UniformGrid Columns="2" Margin="0,0,0,14">
                <RadioButton x:Name="HostFriends" GroupName="HostAudience" IsChecked="True" Margin="0,0,7,0" Padding="12,10">
                  <StackPanel><TextBlock Text="Mes amis" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Muted}" FontSize="12" Text="Sur invitation, avec un mot de passe."/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="HostPublic" GroupName="HostAudience" Margin="7,0,0,0" Padding="12,10">
                  <StackPanel><TextBlock Text="Tout le monde" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Muted}" FontSize="12" Text="Visible dans le catalogue public."/></StackPanel>
                </RadioButton>
              </UniformGrid>
              <TextBlock Text="Joueurs maximum" Margin="0,0,0,6"/>
              <ComboBox x:Name="HostPlayers" Width="120" HorizontalAlignment="Left" SelectedIndex="1" Margin="0,0,0,14" AutomationProperties.Name="Joueurs maximum">
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="4"/>
                <ComboBoxItem Content="8"/>
                <ComboBoxItem Content="16"/>
              </ComboBox>
              <Expander Header="Options avancées" Foreground="{StaticResource Text}" Margin="0,0,0,14">
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Port, mot de passe et sauvegardes se règlent dans le paquet serveur S4Together (fichier de configuration et SuguPanel)."/>
              </Expander>
              <Button Content="Préparer mon serveur →" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="Host_Click"/>
              <TextBlock x:Name="HostStatus" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Diagnostic -->      <Grid x:Name="PageDiag" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Style="{StaticResource H1}" Text="Diagnostic"/>
        <ListBox x:Name="DiagList" Grid.Row="1" Margin="0,0,0,10">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="2,4">
                <TextBlock Text="{Binding Mark}" Foreground="{Binding Color}" FontWeight="Bold" Width="26"/>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Width="190"/>
                <TextBlock Text="{Binding Detail}" Width="520"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
          <Button Style="{StaticResource Primary}" Content="Lancer le diagnostic" Click="RunDiag_Click"/>
          <Button Content="Exporter (sans secret)…" Click="ExportDiag_Click"/>
        </StackPanel>
      </Grid>

      <!-- Admin : visible seulement si le serveur accorde un rôle d'administration -->
      <StackPanel x:Name="PageAdmin" Visibility="Collapsed" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource H1}" Text="Admin"/>
        <TextBlock x:Name="AdminText" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="Joueurs connectés"/>
            <ListBox x:Name="AdminPlayers" Height="200" DisplayMemberPath="Label" Margin="0,0,0,10" AutomationProperties.Name="Joueurs"
                     SelectionChanged="AdminPlayers_Changed"/>
            <StackPanel x:Name="AdminRolesRow" Orientation="Horizontal">
              <ComboBox x:Name="AdminRole" Width="160" Margin="0,0,8,0" DisplayMemberPath="Label" AutomationProperties.Name="Rôle"/>
              <Button Style="{StaticResource Primary}" Content="Attribuer le rôle" Click="AssignRole_Click"/>
              <Button Content="Retirer le rôle" Click="RevokeRole_Click"/>
            </StackPanel>
            <TextBlock x:Name="AdminStatus" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        <Border x:Name="AdminSanctionsCard" Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="Sanctions"/>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="S'applique au joueur choisi ci-dessus. Sans joueur choisi, la liste montre toutes les sanctions, y compris celles des joueurs hors ligne."/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <ComboBox x:Name="SanctionKind" Width="220" Margin="0,0,8,0" DisplayMemberPath="Label" SelectionChanged="SanctionKind_Changed" AutomationProperties.Name="Type de sanction"/>
              <ComboBox x:Name="SanctionDuration" Width="140" DisplayMemberPath="Label" AutomationProperties.Name="Durée"/>
            </StackPanel>
            <TextBlock Text="Motif (obligatoire, enregistré dans l'audit du serveur)" Margin="0,0,0,4"/>
            <TextBox x:Name="SanctionReason" MaxLength="1000" Margin="0,0,0,8" AutomationProperties.Name="Motif"/>
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Primary}" Content="Appliquer la sanction" Click="ApplySanction_Click"/>
              <Button Content="Lever la sanction choisie" Click="RevokeSanction_Click"/>
              <Button Content="Toutes les sanctions" Click="AllSanctions_Click"/>
            </StackPanel>
            <ListBox x:Name="SanctionList" Height="160" DisplayMemberPath="Label" Margin="0,10,0,0" AutomationProperties.Name="Sanctions"/>
            <TextBlock x:Name="SanctionStatus" Margin="0,10,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border x:Name="AdminSeasonCard" Style="{StaticResource CardBorder}" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="Saison du monde"/>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Réinitialiser efface la saison choisie : un joueur présent avec Saisons pourra en choisir une nouvelle. Réservé au propriétaire."/>
            <TextBlock Text="Motif (obligatoire, enregistré dans l'audit du serveur)" Margin="0,0,0,4"/>
            <TextBox x:Name="SeasonResetReason" MaxLength="500" Margin="0,0,0,8" AutomationProperties.Name="Motif de réinitialisation"/>
            <Button HorizontalAlignment="Left" Content="Réinitialiser la saison" Click="ResetSeason_Click"/>
            <TextBlock x:Name="SeasonResetStatus" Margin="0,10,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Muted}" FontSize="11"
                   Text="Le serveur vérifie chaque action : seuls les joueurs de rôle inférieur au tien sont concernés. Sauvegardes et maintenance restent dans SuguPanel."/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE946;" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
        <TextBlock x:Name="StatusBar" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    </Grid>

    <!-- Panneau de droite : profil, amis, partie en ligne. -->
    <Border Grid.Column="2" Background="{StaticResource SidePanel}" BorderBrush="{StaticResource SideLine}" BorderThickness="1,0,0,0" Padding="16,20,16,16">
      <DockPanel>
        <Button DockPanel.Dock="Top" Click="OpenProfile_Click" Padding="6" Margin="0,0,0,18" Background="Transparent" BorderBrush="Transparent"
                HorizontalContentAlignment="Stretch" AutomationProperties.Name="Ouvrir le profil">
          <DockPanel>
            <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,10,0">
              <Border CornerRadius="20" Background="#B89C79">
                <TextBlock x:Name="ProfileInitial" Text="S" FontSize="17" FontWeight="Bold" Foreground="#211B19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Ellipse x:Name="ProfileDot" Width="11" Height="11" Fill="{StaticResource Online}" Stroke="{StaticResource SidePanel}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            </Grid>
            <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="ProfileName" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="ProfileState" Style="{StaticResource Muted}" FontSize="11" TextWrapping="NoWrap"/>
            </StackPanel>
          </DockPanel>
        </Button>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource SideLine}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,14,0,0">
          <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Text="Projet non officiel, non affilié à Electronic Arts ni à Maxis."/>
        </Border>

        <!-- Ta partie en ligne : rejoindre ou se déconnecter. -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Card}" CornerRadius="5" Padding="14">
          <StackPanel>
            <TextBlock Text="TA PARTIE EN LIGNE" Foreground="#C6AD93" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock x:Name="PartyTitle" Text="Prêt à rejoindre tes amis." FontWeight="SemiBold" FontSize="14" Margin="0,8,0,4" TextWrapping="Wrap"/>
            <TextBlock x:Name="PartyText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Choisis ton personnage après avoir rejoint le serveur."/>
            <Button x:Name="PartyButton" Style="{StaticResource Outline}" Content="Rejoindre →" HorizontalAlignment="Stretch" Click="PartyButton_Click" Margin="0"/>
          </StackPanel>
        </Border>

        <!-- Amis : favoris du joueur, en ligne s'ils sont sur le même serveur. -->
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="4,0,0,8">
            <Button DockPanel.Dock="Right" Content="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="11" Padding="7" Margin="0"
                    Background="Transparent" BorderBrush="Transparent" Click="AddShellFriend_Click" ToolTip="Ajouter un ami" AutomationProperties.Name="Ajouter un ami"/>
            <TextBlock Text="Amis" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            <TextBlock x:Name="FriendsCount" Style="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock x:Name="ShellFriendsEmpty" DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="4,0,4,8"
                     Text="Aucun ami pour l'instant. Connecte-toi à un serveur puis ajoute des joueurs avec ＋."/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <ItemsControl x:Name="ShellFriendList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="4,5">
                    <Grid DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,10,0">
                      <Border CornerRadius="16" Background="#4A5068">
                        <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <Ellipse Width="9" Height="9" Fill="{StaticResource Online}" Stroke="{StaticResource SidePanel}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Visibility="{Binding OnlineVisibility}"/>
                    </Grid>
                    <Button DockPanel.Dock="Right" Content="⋯" Padding="6,2" Margin="0" Background="Transparent" BorderBrush="Transparent" Tag="{Binding Name}"
                            Click="ShellFriendMenu_Click" ToolTip="Options" AutomationProperties.Name="Options de l'ami"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
